# Copy to .env.local and configure MongoDB Atlas.
# Keep credentials server-side; never use NEXT_PUBLIC_ for secrets.

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Set your MongoDB Atlas connection URI here.
MONGODB_URI=
MONGODB_DB=airguard

# Official Government of India OGD CPCB station feed (server-side only).
# Generate a personal API key after creating an account at data.gov.in.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_AQI_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Optional supplementary key; XKDR is not used as a live source by this app.
XKDR_API_KEY=

# Supabase is not wired into this MongoDB-backed project. These are informational placeholders only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Optional local FastAPI Random Forest service. Predictions remain unavailable until a validated model artifact is installed.
ML_SERVICE_URL=http://localhost:8000

# Open-Meteo is used directly by the server; no API key is needed for eligible non-commercial use.
