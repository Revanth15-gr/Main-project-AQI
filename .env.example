# Copy to .env.local and configure MongoDB Atlas.
# Keep credentials server-side; never use NEXT_PUBLIC_ for secrets.

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Set your MongoDB Atlas connection URI here.
MONGODB_URI=
MONGODB_DB=airguard

# Optional local FastAPI Random Forest service. Predictions remain unavailable until a validated model artifact is installed.
ML_SERVICE_URL=http://localhost:8000

# Open-Meteo is used directly by the server; no API key is needed for eligible non-commercial use.
