# AirGuard auth and notification data use MongoDB Atlas. Keep credentials server-side.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/airguard?retryWrites=true&w=majority&appName=AirGuard
MONGODB_DB=airguard

# Optional PostgreSQL store for CPCB station snapshots.
# Authentication and phone verification do not use this database.
DATABASE_URL=

# CPCB real-time air-quality resource on data.gov.in.
# Obtain a personal key from your data.gov.in account. The public sample key is capped at 10 rows.
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_AQI_RESOURCE_ID=3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69

# Optional XKDR key; the current app does not use XKDR for live readings.
XKDR_API_KEY=

# Open-Meteo is used for model estimates and India location search; no key is required for eligible use.
OPEN_METEO_BASE_URL=https://air-quality-api.open-meteo.com/v1/air-quality

# Protect the externally scheduled hourly CPCB ingestion endpoint.
AIR_QUALITY_CRON_SECRET=

# Twilio Programmable Messaging. Keep all values server-side.
# E.164 sender numbers. WhatsApp senders must be approved on your Twilio account.
# New-account SMS verification needs only the account SID, auth token, SMS number, and TWILIO_ENABLED=true.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Optional alternative to TWILIO_AUTH_TOKEN. TWILIO_ACCOUNT_SID is still required.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=
TWILIO_STATUS_CALLBACK_URL=https://your-domain.example/api/webhooks/twilio/status
# Approved WhatsApp template with one {{1}} placeholder for the verification code.
TWILIO_WHATSAPP_OTP_CONTENT_SID=
# Approved Content Template SID with one {{1}} placeholder for general WhatsApp notifications.
TWILIO_WHATSAPP_GENERIC_CONTENT_SID=
# Approved Content Template SID with {{1}} location, {{2}} AQI, {{3}} category, {{4}} data source.
TWILIO_WHATSAPP_CONTENT_SID=
TWILIO_ENABLED=false

# OpenAI-compatible chat completions endpoint. Use a model provider API key.
AI_BASE_URL=https://api.openai.com/v1/responses
AI_MODEL=gpt-4.1-mini
AI_API_KEY=

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
