# Copy to .env.local and fill from your Supabase project.
# Use the server-side PostgreSQL connection string; never prefix it with NEXT_PUBLIC_.
DATABASE_URL=postgresql://postgres:<password>@<host>:5432/postgres

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=

# Use the origin where this app runs.
BETTER_AUTH_URL=http://localhost:3000
